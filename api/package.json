{
  "name": "@relay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node ../node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ../node_modules/vitest/vitest.mjs run --passWithNoTests",
    "seed": "node ../node_modules/tsx/dist/cli.mjs scripts/seed.ts",
    "verify:rls": "node ../node_modules/tsx/dist/cli.mjs scripts/verify-rls.ts"
  },
  "dependencies": {
    "@relay/shared": "*",
    "@supabase/supabase-js": "^2.57.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
